--- a/src/main/java/benchmark/generators/tools/runners/difffold/DifffoldBinary.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/main/java/benchmark/generators/tools/runners/difffold/DifffoldBinary.java	2026-11-04 23:40:01.238451361 +0000
@@ -0,0 +1,94 @@
+package benchmark.generators.tools.runners.difffold;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+/** Runs difffold's {@code ted_map} binary on two Java sources and parses its JSON output. */
+public class DifffoldBinary {
+    /** A matched node pair as byte ranges and tree-sitter kinds. */
+    public record Pair(int bs, int be, String bkind, int as, int ae, String akind) {}
+
+    /** The matched pairs plus the byte ranges of every node of both trees. */
+    public record Result(List<Pair> pairs, int[][] beforeRanges, int[][] afterRanges) {}
+
+    public static String binaryPath() {
+        String p = System.getProperty("difffold.bin", System.getenv("DIFFFOLD_TED_MAP"));
+        if (p == null) throw new IllegalStateException("set -Ddifffold.bin or DIFFFOLD_TED_MAP to the ted_map binary");
+        return p;
+    }
+
+    public static long timeoutSeconds() {
+        return Long.getLong("difffold.timeout", 120L);
+    }
+
+    /** Thrown when the binary fails or times out. */
+    public static class ToolFailure extends RuntimeException {
+        public ToolFailure(String m) { super(m); }
+    }
+
+    public static Result run(String algo, byte[] before, byte[] after) throws IOException, InterruptedException {
+        Path dir = Files.createTempDirectory("dfbin");
+        try {
+            Path b = dir.resolve("before.java");
+            Path a = dir.resolve("after.java");
+            Path out = dir.resolve("out.json");
+            Files.write(b, before);
+            Files.write(a, after);
+            // The address space limit keeps one pathological file from exhausting the shared memory.
+            Process proc = new ProcessBuilder("prlimit", "--as=" + Long.getLong("difffold.memlimit", 3_000_000_000L),
+                    binaryPath(), "--algo", algo, b.toString(), a.toString())
+                    .redirectOutput(out.toFile())
+                    .redirectError(ProcessBuilder.Redirect.DISCARD)
+                    .start();
+            if (!proc.waitFor(timeoutSeconds(), TimeUnit.SECONDS)) {
+                proc.destroyForcibly();
+                throw new ToolFailure("timeout after " + timeoutSeconds() + "s");
+            }
+            if (proc.exitValue() != 0) throw new ToolFailure("exit " + proc.exitValue());
+            JsonNode root = new ObjectMapper().readTree(out.toFile());
+            List<Pair> pairs = new ArrayList<>();
+            for (JsonNode p : root.get("pairs"))
+                pairs.add(new Pair(p.get(0).asInt(), p.get(1).asInt(), p.get(2).asText(),
+                        p.get(3).asInt(), p.get(4).asInt(), p.get(5).asText()));
+            return new Result(pairs, ranges(root.get("bn")), ranges(root.get("an")));
+        } finally {
+            for (File f : dir.toFile().listFiles()) f.delete();
+            dir.toFile().delete();
+        }
+    }
+
+    private static int[][] ranges(JsonNode arr) {
+        int[][] r = new int[arr.size()][2];
+        for (int i = 0; i < r.length; i++) {
+            r[i][0] = arr.get(i).get(0).asInt();
+            r[i][1] = arr.get(i).get(1).asInt();
+        }
+        return r;
+    }
+
+    /** UTF-8 byte offset to UTF-16 char index, as JDT positions are char indices. */
+    public static int[] byteToChar(String s) {
+        byte[] bytes = s.getBytes(StandardCharsets.UTF_8);
+        int[] map = new int[bytes.length + 1];
+        int bi = 0;
+        for (int ci = 0; ci < s.length(); ) {
+            int cp = s.codePointAt(ci);
+            int nb = cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
+            int nc = Character.charCount(cp);
+            for (int k = 0; k < nb; k++) map[bi + k] = ci;
+            bi += nb;
+            ci += nc;
+        }
+        map[bytes.length] = s.length();
+        return map;
+    }
+}
diff -ruN a/src/main/java/benchmark/generators/tools/runners/difffold/DifffoldMatcher.java b/src/main/java/benchmark/generators/tools/runners/difffold/DifffoldMatcher.java
--- a/src/main/java/benchmark/generators/tools/runners/difffold/DifffoldMatcher.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/main/java/benchmark/generators/tools/runners/difffold/DifffoldMatcher.java	2026-11-04 23:40:01.238386749 +0000
@@ -0,0 +1,215 @@
+package benchmark.generators.tools.runners.difffold;
+
+import com.github.gumtreediff.matchers.MappingStore;
+import com.github.gumtreediff.matchers.Matcher;
+import com.github.gumtreediff.tree.Tree;
+import com.github.gumtreediff.matchers.Configurable;
+import com.github.gumtreediff.matchers.GumtreeProperties;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * A GumTree {@link Matcher} whose mappings come from difffold's tree-sitter based mapping.
+ *
+ * <p>Conversion rule. difffold emits matched node pairs as UTF-8 byte ranges plus tree-sitter kinds.
+ * Byte ranges are converted to char offsets and looked up in the JDT tree DiffBenchmark builds, as
+ * the chain of JDT nodes (outermost first) whose [pos, endPos) equals the range. If no JDT node has
+ * exactly that range, nodes whose range differs only by a leading Javadoc or comment are accepted,
+ * because tree-sitter keeps comments outside a declaration while JDT includes the Javadoc in it.
+ * For a pair, every JDT node type present in both chains is mapped (k-th occurrence of a type on the
+ * before side to the k-th on the after side), so a same-range wrapper such as SimpleType over
+ * SimpleName is mapped on both levels. Only same-type JDT pairs are produced, matching GumTree's type
+ * rule and the oracle (it contains no cross-type mapping). Pairs are classified in
+ * {@link ConversionStats} as converted, noJdtNode, crossType or conflict. The tree-sitter kinds are
+ * not consulted: the range and the JDT type decide.
+ */
+public class DifffoldMatcher implements Matcher {
+    private final String algo;
+    private final String srcContent;
+    private final String dstContent;
+    private final ConversionStats stats;
+    private GumtreeProperties properties = new GumtreeProperties();
+
+    public DifffoldMatcher(String algo, String srcContent, String dstContent, ConversionStats stats) {
+        this.algo = algo;
+        this.srcContent = srcContent;
+        this.dstContent = dstContent;
+        this.stats = stats;
+    }
+
+    @Override
+    public void configure(GumtreeProperties properties) {
+        this.properties = properties;
+    }
+
+    @Override
+    public MappingStore match(Tree src, Tree dst, MappingStore mappings) {
+        DifffoldBinary.Result res;
+        try {
+            res = DifffoldBinary.run(algo, srcContent.getBytes(StandardCharsets.UTF_8), dstContent.getBytes(StandardCharsets.UTF_8));
+        } catch (IOException | InterruptedException e) {
+            throw new DifffoldBinary.ToolFailure(e.toString());
+        }
+        int[] b2c = DifffoldBinary.byteToChar(srcContent);
+        int[] a2c = DifffoldBinary.byteToChar(dstContent);
+        Index si = new Index(src, srcContent);
+        Index di = new Index(dst, dstContent);
+        si.markAddressable(res.beforeRanges(), b2c);
+        di.markAddressable(res.afterRanges(), a2c);
+        for (DifffoldBinary.Pair p : res.pairs()) {
+            stats.pairs.incrementAndGet();
+            boolean[] viaComment = new boolean[1];
+            List<Tree> cb = si.lookup(b2c[p.bs()], b2c[p.be()], viaComment);
+            List<Tree> ca = di.lookup(a2c[p.as()], a2c[p.ae()], viaComment);
+            if (cb.isEmpty() || ca.isEmpty()) {
+                stats.noJdtNode.incrementAndGet();
+                continue;
+            }
+            boolean shared = false;
+            boolean added = false;
+            Map<String, Integer> seen = new HashMap<>();
+            for (Tree u : cb) {
+                String type = u.getType().name;
+                int k = seen.merge(type, 1, Integer::sum);
+                Tree v = nth(ca, type, k);
+                if (v == null) continue;
+                shared = true;
+                if (mappings.getDstForSrc(u) == v) {
+                    added = true;
+                    continue;
+                }
+                if (mappings.isSrcMapped(u) || mappings.isDstMapped(v)) continue;
+                mappings.addMapping(u, v);
+                stats.jdtMappings.incrementAndGet();
+                added = true;
+            }
+            if (added) {
+                stats.converted.incrementAndGet();
+                if (viaComment[0]) stats.convertedViaComment.incrementAndGet();
+            } else if (shared) stats.conflict.incrementAndGet();
+            else stats.crossType.incrementAndGet();
+        }
+        if (!Boolean.getBoolean("difffold.nocomplete")) complete(src, mappings, si, di);
+        int n = 0;
+        int m = 0;
+        for (Tree t : src.preOrder()) {
+            if (insideComment(t)) continue;
+            n++;
+            if (mappings.isSrcMapped(t)) m++;
+        }
+        stats.jdtSrcNodes.addAndGet(n);
+        stats.jdtSrcMapped.addAndGet(m);
+        return mappings;
+    }
+
+    /**
+     * Maps JDT nodes that no tree-sitter node can address, such as RefactoringMiner's
+     * METHOD_INVOCATION_ARGUMENTS and TYPE_DECLARATION_KIND wrappers. Under each mapped pair, the
+     * unmapped unaddressable children of the same type are paired in order, top-down, so the
+     * wrappers follow their parents. Addressable nodes are never touched here.
+     */
+    private void complete(Tree src, MappingStore mappings, Index si, Index di) {
+        for (Tree u : src.preOrder()) {
+            Tree v = mappings.getDstForSrc(u);
+            if (v == null) continue;
+            Map<String, List<Tree>> byType = new HashMap<>();
+            for (Tree c : v.getChildren())
+                if (!mappings.isDstMapped(c) && !di.addressable(c) && !insideComment(c))
+                    byType.computeIfAbsent(c.getType().name, k -> new ArrayList<>()).add(c);
+            Map<String, Integer> used = new HashMap<>();
+            for (Tree c : u.getChildren()) {
+                if (mappings.isSrcMapped(c) || si.addressable(c) || insideComment(c)) continue;
+                List<Tree> cands = byType.get(c.getType().name);
+                int k = used.merge(c.getType().name, 1, Integer::sum) - 1;
+                if (cands == null || k >= cands.size()) continue;
+                mappings.addMapping(c, cands.get(k));
+                stats.completed.incrementAndGet();
+            }
+        }
+    }
+
+    private static boolean insideComment(Tree t) {
+        for (Tree x = t; x != null; x = x.getParent()) {
+            String n = x.getType().name;
+            if (n.equals("Javadoc") || n.equals("LineComment") || n.equals("BlockComment")) return true;
+        }
+        return false;
+    }
+
+    private static Tree nth(List<Tree> chain, String type, int k) {
+        int c = 0;
+        for (Tree t : chain) if (t.getType().name.equals(type) && ++c == k) return t;
+        return null;
+    }
+
+    /** Index of a JDT tree by exact range and by range with leading comments skipped. */
+    static class Index {
+        final Map<Long, List<Tree>> exact = new HashMap<>();
+        final Map<Long, List<Tree>> core = new HashMap<>();
+        final java.util.Set<Long> tsRanges = new java.util.HashSet<>();
+        final String content;
+        final java.util.IdentityHashMap<Tree, Boolean> addressableCache = new java.util.IdentityHashMap<>();
+
+        Index(Tree root, String content) {
+            this.content = content;
+            for (Tree t : root.preOrder()) {
+                int s = t.getPos();
+                int e = t.getEndPos();
+                exact.computeIfAbsent(key(s, e), x -> new ArrayList<>()).add(t);
+                int q = skipComments(content, s, e);
+                if (q > s) core.computeIfAbsent(key(q, e), x -> new ArrayList<>()).add(t);
+            }
+        }
+
+        void markAddressable(int[][] byteRanges, int[] byteToChar) {
+            for (int[] r : byteRanges) tsRanges.add(key(byteToChar[r[0]], byteToChar[r[1]]));
+        }
+
+        /** True when some tree-sitter node has this node's range (or its range without leading comments). */
+        boolean addressable(Tree t) {
+            int s = t.getPos();
+            int e = t.getEndPos();
+            if (tsRanges.contains(key(s, e))) return true;
+            int q = skipComments(content, s, e);
+            return q > s && tsRanges.contains(key(q, e));
+        }
+
+        List<Tree> lookup(int s, int e, boolean[] viaComment) {
+            List<Tree> l = exact.get(key(s, e));
+            if (l != null) return l;
+            l = core.get(key(s, e));
+            if (l != null) {
+                viaComment[0] = true;
+                return l;
+            }
+            return List.of();
+        }
+
+        static long key(int s, int e) {
+            return ((long) s << 32) | (e & 0xffffffffL);
+        }
+
+        static int skipComments(String c, int s, int e) {
+            int q = s;
+            while (q < e) {
+                char ch = c.charAt(q);
+                if (Character.isWhitespace(ch)) q++;
+                else if (c.startsWith("/*", q)) {
+                    int end = c.indexOf("*/", q + 2);
+                    if (end < 0) return s;
+                    q = end + 2;
+                } else if (c.startsWith("//", q)) {
+                    int end = c.indexOf('\n', q);
+                    if (end < 0) return s;
+                    q = end + 1;
+                } else break;
+            }
+            return q;
+        }
+    }
+}
diff -ruN a/src/main/java/rq/difffold/ConversionCeiling.java b/src/main/java/rq/difffold/ConversionCeiling.java
--- a/src/main/java/rq/difffold/ConversionCeiling.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/main/java/rq/difffold/ConversionCeiling.java	2026-11-04 23:40:01.238550839 +0000
@@ -0,0 +1,83 @@
+package rq.difffold;
+
+import benchmark.generators.tools.runners.difffold.ConversionStats;
+import benchmark.generators.tools.runners.difffold.DifffoldMatcher;
+import com.github.gumtreediff.matchers.MappingStore;
+import com.github.gumtreediff.tree.Tree;
+import org.refactoringminer.astDiff.models.ASTDiff;
+import org.refactoringminer.astDiff.models.ProjectASTDiff;
+import org.refactoringminer.rm1.GitHistoryRefactoringMinerImpl;
+
+import java.io.PrintWriter;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.*;
+
+/**
+ * Measures the loss of the byte-range to JDT conversion alone: each fixture's before file is diffed
+ * against itself plus a trailing comment (RefactoringMiner reports no diff for identical files), so every JDT node has a true counterpart. The fraction of JDT nodes (outside
+ * comments) that stay unmapped is the ceiling the conversion puts on any difffold result.
+ *
+ * usage: ConversionCeiling FIXTURES_DIR OUT_CSV [limit]
+ */
+public class ConversionCeiling {
+    public static void main(String[] args) throws Exception {
+        Path fixtures = Path.of(args[0]);
+        int limit = args.length > 2 && Integer.parseInt(args[2]) > 0 ? Integer.parseInt(args[2]) : Integer.MAX_VALUE;
+        List<Path> dirs = new ArrayList<>();
+        try (var ds = Files.newDirectoryStream(fixtures)) {
+            for (Path d : ds) if (Files.exists(d.resolve("before.java.test"))) dirs.add(d);
+        }
+        Collections.sort(dirs);
+        long nodes = 0, mapped = 0;
+        int files = 0;
+        Map<String, long[]> byType = new TreeMap<>();
+        ConversionStats cs = new ConversionStats();
+        for (Path d : dirs) {
+            if (files >= limit) break;
+            Path tmp = Files.createTempDirectory("ceil");
+            try {
+                Path b = tmp.resolve("b"), a = tmp.resolve("a");
+                Files.createDirectories(b);
+                Files.createDirectories(a);
+                Files.copy(d.resolve("before.java.test"), b.resolve("F.java"));
+                Files.writeString(a.resolve("F.java"), Files.readString(d.resolve("before.java.test")) + "\n// ceiling\n");
+                ProjectASTDiff p = new GitHistoryRefactoringMinerImpl().diffAtDirectories(b, a);
+                ASTDiff diff = p.getDiffSet().iterator().next();
+                String content = p.getFileContentsBefore().get(diff.getSrcPath());
+                String after = p.getFileContentsAfter().get(diff.getDstPath());
+                MappingStore ms = new DifffoldMatcher("topdown", content, after, cs).match(diff.src.getRoot(), diff.dst.getRoot());
+                for (Tree t : diff.src.getRoot().preOrder()) {
+                    boolean comment = false;
+                    for (Tree x = t; x != null; x = x.getParent()) {
+                        String n = x.getType().name;
+                        if (n.equals("Javadoc") || n.equals("LineComment") || n.equals("BlockComment")) comment = true;
+                    }
+                    if (comment) continue;
+                    long[] c = byType.computeIfAbsent(t.getType().name, k -> new long[2]);
+                    c[0]++;
+                    nodes++;
+                    if (ms.isSrcMapped(t)) { c[1]++; mapped++; }
+                }
+                files++;
+            } catch (Throwable t) {
+                System.err.println("skip " + d.getFileName() + ": " + t);
+            } finally {
+                deleteRec(tmp.toFile());
+            }
+        }
+        try (PrintWriter w = new PrintWriter(args[1])) {
+            w.println("jdt_type,nodes,mapped,unmapped");
+            w.println("ALL," + nodes + "," + mapped + "," + (nodes - mapped));
+            byType.entrySet().stream().sorted((x, y) -> Long.compare(y.getValue()[0] - y.getValue()[1], x.getValue()[0] - x.getValue()[1]))
+                    .forEach(e -> w.println(e.getKey() + "," + e.getValue()[0] + "," + e.getValue()[1] + "," + (e.getValue()[0] - e.getValue()[1])));
+        }
+        System.out.println("files=" + files + " nodes=" + nodes + " mapped=" + mapped + " ceiling=" + (double) mapped / nodes + " " + cs);
+    }
+
+    static void deleteRec(java.io.File f) {
+        java.io.File[] kids = f.listFiles();
+        if (kids != null) for (java.io.File k : kids) deleteRec(k);
+        f.delete();
+    }
+}
diff -ruN a/src/main/java/rq/difffold/D4JAccuracyDriver.java b/src/main/java/rq/difffold/D4JAccuracyDriver.java
